{
  "name": "portofolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:css": "sass ./src/styles/main.scss ./src/styles/main.css --no-source-map",
    "build:html": "mkdir -p ./dist && cp ./src/pages/index.html ./dist/index.html",
    "build": "npm run build:css && tailwindcss -i ./src/styles/main.css -o ./dist/output.css && npm run build:html",
    "watch:css": "sass --watch ./src/styles/main.scss ./src/styles/main.css --no-source-map",
    "watch:tw": "tailwindcss -i ./src/styles/main.css -o ./dist/output.css --watch"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.18",
    "postcss": "^8.4.35",
    "sass": "^1.97.1",
    "tailwindcss": "^3.4.1"
  }
}
